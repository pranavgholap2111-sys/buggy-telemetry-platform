# ── Ingest service environment variables ────────────────────
# Copy this file to .env and adjust values:
#   copy .env.example .env
#
# NEVER commit .env — it is in .gitignore.

# ── Server ──────────────────────────────────────────────────
PORT=4000
# Allowed origins for CORS (comma-separated)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# ── PostgreSQL ──────────────────────────────────────────────
# Must match the POSTGRES_USER / POSTGRES_PASSWORD / POSTGRES_DB
# in infra/docker-compose.yml
DB_HOST=localhost
DB_PORT=5433
DB_USER=buggy
DB_PASSWORD=buggy_dev_pw
DB_NAME=buggy_telemetry

# ── MQTT broker ─────────────────────────────────────────────
MQTT_URL=mqtt://localhost:1883

# ── JWT (used in Stage 7 for auth) ──────────────────────────
# Generate a random string:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=change-me-to-a-random-string-in-production
JWT_EXPIRY=12h

# ── Trip idle timeout (seconds) ─────────────────────────────
# A trip is considered ended after this many seconds without telemetry
TRIP_IDLE_TIMEOUT_S=60
