# Analysis worker environment variables
# Copy this file to .env and adjust values:
#   copy .env.example .env
#
# NEVER commit .env — it is in .gitignore.

# ── PostgreSQL ──────────────────────────────────────────────
# Must match the POSTGRES_USER / POSTGRES_PASSWORD / POSTGRES_DB
# in infra/docker-compose.yml
DB_HOST=localhost
DB_PORT=5433
DB_USER=buggy
DB_PASSWORD=buggy_dev_pw
DB_NAME=buggy_telemetry

# ── Polling interval (seconds) ──────────────────────────────
POLL_INTERVAL_S=5
